# DATABASE_URL - Conexão com PostgreSQL (Neon)
# Formato: postgresql://username:password@hostname:port/database
# Exemplo: postgresql://neondb_owner:neon_pw@ep-name-region-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# Esta variável é lida pelo arquivo drizzle.config.json e por src/db/index.ts
# Não comite valores reais de senha/credentials em ambientes públicos.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Authentication
ALLOWED_EMAILS=edu@doc2b.com.br,andre@doc2b.com.br
RESEND_API_KEY=sua-chave-resend-aqui
SESSION_SECRET=sua-secret-key-aqui-gere-com-openssl
EMAIL_PROVIDER=resend

# Rate Limiting (em produção, configurar no Redis ou provedor)
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MIN=1